  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StudyXR.XRInteraction.StationGuide
  guideText: {fileID: 221338609}
  panel: {fileID: 1175283288}
  scope: {fileID: 2005569960}
  zoneHub: {fileID: 384603198}
  zoneIndex: 3
  title: "\uAD6C\uC5ED 4 \xB7 \uC18C\uCF13 (XRSocketInteractor)"
  body: "\uC624\uB978\uCABD \uB4A4 : \uBAA8\uC591\uC744 \uC18C\uCF13 \uAC00\uAE4C\uC774
    \uB193\uC73C\uBA74 \uB04C\uB824 \uB4E4\uC5B4\uAC00 \uACE0\uC815\uB429\uB2C8\uB2E4\n\uC67C\uCABD
    : \uD398\uB97C\uB7EC \uBA38\uC2E0 \u2014 \uBC30\uD130\uB9AC\uB294 \uB9DE\uB294
    \uC18C\uCF13\uC5D0\uB9CC (XRLockSocketInteractor)\n\uC18C\uCF13\uB3C4 Interactor
    \uC785\uB2C8\uB2E4 : \uC190 \uB300\uC2E0 \uC18C\uCF13\uC774 Select \uD569\uB2C8\uB2E4\n\uADF8\uB9BD
    : \uC7A1\uAE30 \xB7 \uB193\uAE30 \xB7 \uC67C\uC190 X : \uC548\uB0B4\uD310 \xB7
    \uC67C\uC190 Y : \uC131\uB2A5"
  maxEvents: 3
  useToggleButton: 1
